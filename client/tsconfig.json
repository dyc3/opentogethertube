{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"target": "es2018",
		"paths": {
			"@/*": ["./src/*"]
		},
		"jsx": "preserve",
		// ott-common and vuex export extensionless subpaths ("./*": "./*")
		"resolvePackageJsonExports": false
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "tests/**/*.ts", "tests/**/*.tsx"],
	"exclude": ["node_modules", "dist", "ts-out"]
}
